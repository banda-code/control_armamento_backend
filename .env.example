# Copie este archivo como .env y reemplace todos los valores CAMBIAR.
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_DJANGO_LARGA
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/La_Paz

DB_NAME=control_armamento
DB_USER=armamento_user
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_POSTGRES_SEGURA
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CSRF_COOKIE_SECURE=False

JWT_SIGNING_KEY=CAMBIAR_POR_UNA_CLAVE_JWT_DISTINTA_A_SECRET_KEY
JWT_ACCESS_TOKEN_MINUTES=10
JWT_REFRESH_TOKEN_HOURS=8
JWT_REFRESH_COOKIE_NAME=armamento_refresh
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
JWT_COOKIE_PATH=/api/auth/
JWT_ISSUER=control-armamento.armada.mil.bo
JWT_AUDIENCE=control-armamento-frontend

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=sistema.armamento@armada.mil.bo
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sistema de Control de Armamento <sistema.armamento@armada.mil.bo>

FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/restablecer-contrasena
PASSWORD_RESET_TIMEOUT=3600
